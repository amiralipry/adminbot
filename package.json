{
  "name": "sikaap-admin-bot",
  "version": "2.0.0",
  "description": "ربات هوشمند بازنشر محتوای چندکاناله تلگرام به بله و روبیکا با موتور فوق‌سریع Bun و TypeScript",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "bot": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "grammy": "^1.46.0"
  }
}

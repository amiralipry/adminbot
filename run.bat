@echo off
chcp 65001 > nul
title ربات بازنشر چندکاناله سیکاپ (Bun + SQLite + Auto-Restart)

echo ======================================================================
echo   🚀 ربات بازنشر چندکاناله محتوا (تلگرام ➔ بله، روبیکا و ایتا)
echo   ⚙️ موتور اجرا: Bun + SQLite داخلی + استریم فایل‌های حجیم + صف تلاش
echo   🌐 داشبورد وب مدیریتی: http://localhost:5000
echo ======================================================================
echo.

:loop
echo [%date% %time%] در حال شروع فرآیند ربات...
bun run src/index.ts

echo.
echo ⚠️ فرآیند ربات متوقف شد یا خطایی رخ داد (کد خروج: %ERRORLEVEL%).
echo 🔄 راه‌اندازی مجدد خودکار پس از ۵ ثانیه... (جهت لغو Ctrl+C را فشار دهید)
timeout /t 5 /nobreak > nul
echo.
goto loop

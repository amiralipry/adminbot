# ==================================================================
# راهنمای تنظیمات ربات بازنشر محتوا (تلگرام -> بله، ایتا، روبیکا)
# ==================================================================

# 1. تنظیمات تلگرام (Telegram)
# توکن ربات تلگرام را از @BotFather بگیرید و ربات را ادمین کانال خود کنید
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# آیدی یا نام کاربری کانال‌های تلگرامی که می‌خواهید پست‌هایشان بازنشر شود (با کاما جدا کنید)
# اگر علامت * بگذارید، تمام کانال‌هایی که ربات در آنها ادمین است رصد می‌شوند
TELEGRAM_CHANNELS=@MyTelegramChannel
# آیدی عددی ادمین‌های تلگرام برای ارسال مستقیم پیام به پی‌وی ربات و تست (اختیاری)
TELEGRAM_ADMIN_IDS=123456789
LISTEN_PRIVATE_MESSAGES=true

# 2. تنظیمات پیام‌رسان بله (Bale)
# توکن ربات بله را از بازوی BotFather@ در بله بگیرید و ربات را ادمین کانال بله کنید
ENABLE_BALE=true
BALE_BOT_TOKEN=123456789:abcdefghijklmnopqrstuvwxyz
# آیدی کانال بله (مثال: @MyBaleChannel یا شناسه عددی)
BALE_CHANNEL_ID=@MyBaleChannel
# متنی که به انتهای پست‌ها در بله اضافه شود (اختیاری)
BALE_FOOTER=📢 کانال ما در بله: ble.ir/MyBaleChannel

# 3. تنظیمات پیام‌رسان ایتا (Eitaa)
# نوع وب‌سرویس: eitaayar (پیشنهادی با ایتایار) یا direct (مستقیم)
ENABLE_EITAA=true
EITAA_API_TYPE=eitaayar
# توکن ایتا را از پنل eitaayar.ir یا بات رسمی ایتا بگیرید
EITAA_TOKEN=bot12345:abcdef...
# آیدی یا نام کاربری کانال ایتا (مثال: @MyEitaaChannel)
EITAA_CHANNEL_ID=@MyEitaaChannel
EITAA_FOOTER=📢 کانال ما در ایتا: eitaa.com/MyEitaaChannel

# 4. تنظیمات پیام‌رسان روبیکا (Rubika)
# توکن رسمی بات روبیکا را از پنل توسعه‌دهندگان روبیکا یا بات ساز بگیرید
ENABLE_RUBIKA=true
RUBIKA_BOT_TOKEN=rubika_bot_token_here
# GUID یا نام کاربری کانال روبیکا
RUBIKA_CHANNEL_ID=@MyRubikaChannel
RUBIKA_FOOTER=📢 کانال ما در روبیکا: rubika.ir/MyRubikaChannel

# 5. تنظیمات وب‌سرور پنل مدیریت (Dashboard)
ENABLE_WEB_DASHBOARD=true
WEB_HOST=127.0.0.1
WEB_PORT=8080
